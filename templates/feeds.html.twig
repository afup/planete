{% extends 'base.html.twig' %}

{% block body %}

    <table class="w-full text-left">
        <tbody>
        {% for feed in feeds %}
            <tr class="border-b last:border-b-0 border-neutre-300 dark:border-afup-700">
                <th scope="row" class="py-4 pr-6 font-titre font-bold text-afup-800 dark:text-neutre-200 whitespace-nowrap" data-qa="feed-{{ loop.index }}-name">
                    {{ feed.name }}
                    <div class="block sm:hidden font-sans font-normal">
                        <a href="{{ feed.url }}" class="text-afup-500 dark:text-afup-300 hover:underline text-xs" data-qa="feed-{{ loop.index }}-url-mobile">{{ feed.url }}</a>
                    </div>
                </th>
                <td class="py-4 text-sm hidden sm:table-cell">
                    <a href="{{ feed.url }}" class="text-afup-500 dark:text-afup-300 hover:underline break-all" data-qa="feed-{{ loop.index }}-url-desk">{{ feed.url }}</a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
