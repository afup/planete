<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
        <meta http-equiv="x-ua-compatible" content="ie=edge">

        <title>{% block title %}Planète PHP{% endblock %}</title>
        <link rel="icon" href="{{ asset('images/veille-logo.svg') }}" sizes="any" type="image/svg+xml">

        <link rel="alternate" type="application/rss+xml" title="RSS" href="{{ path('rss') }}">

        {% block head %}
        {% endblock %}

        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="font-sans dark:bg-afup-800 flex flex-col min-h-screen justify-between">
        <div>
            <div class="hidden sm:block bg-afup-800 dark:bg-afup-900">
                <nav class="container mx-auto flex text-white justify-center p-1 gap-2">
                    <a href="https://afup.org" class="px-5 py-1 text-sm hover:bg-afup-700 rounded">AFUP</a>
                    <a href="https://event.afup.org" class="px-5 py-1 text-sm hover:bg-afup-700 rounded">{{ afup_global_menu_event_label ?? 'Event' }}</a>
                    <a href="https://barometre.afup.org" class="px-5 py-1 text-sm hover:bg-afup-700 rounded">Baromètre</a>
                    <a href="https://planete-php.fr" class="px-5 py-1 text-sm hover:bg-afup-700 bg-afup-700 rounded">Planète PHP</a>
                    <a href="https://pufa.afup.org" class="px-5 py-1 text-sm hover:bg-afup-700 rounded">PUFA</a>
                </nav>
            </div>

            {% set route = app.request.attributes.get('_route') %}
            <div class="bg-afup-300">
                <nav class="max-w-4xl mx-auto flex flex-col sm:flex-row text-white sm:px-4">
                    <div class="flex items-center grow gap-3 p-2 sm:px-0">
                        <img src="{{ asset('images/afup-icon-inverted.png') }}" class="h-11" alt=""/>
                        <a href="{{ path('index') }}" class="font-titre text-3xl" data-qa="site-name">Planète PHP</a>
                    </div>
                    <div class="flex justify-between font-medium">
                        <a href="{{ path('articles_list') }}" class="px-5 py-4 sm:py-5 border-b-4 {{ route == 'articles_list' ? 'border-white' : 'border-transparent hover:border-white/50' }}">Articles</a>
                        <a href="{{ path('feeds_list') }}" class="px-5 py-4 sm:py-5 border-b-4 {{ route == 'feeds_list' ? 'border-white' : 'border-transparent hover:border-white/50' }}">Sources</a>
                        <a href="{{ url('rss') }}" class="px-5 py-4 sm:py-5 border-b-4 border-transparent hover:border-white/50">Flux RSS</a>
                    </div>
                </nav>
            </div>

            <main class="max-w-4xl mx-auto px-4 py-4">
                {% block body %}{% endblock %}
            </main>
        </div>

        <footer class="bg-afup-900 text-white/70 text-sm">
            <div class="max-w-4xl mx-auto px-4 py-4 flex flex-col sm:flex-row gap-2 justify-between">
                <span>Hébergé sur <a href="https://www.clever-cloud.com" class="text-afup-500 hover:underline">Clever Cloud</a>, code source sur <a href="https://github.com/afup/planete" class="text-afup-500 hover:underline">GitHub</a></span>
                <span>© <a href="https://afup.org" class="hover:underline">AFUP</a> 2000-{{ 'now'|date('Y') }}</span>
            </div>
        </footer>
    </body>
</html>
